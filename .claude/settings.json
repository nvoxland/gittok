{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          },
          {
            "type": "command",
            "command": "uv run --quiet gittok health --hint 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "uv run --quiet gittok feed-watch --hint 2>/dev/null || true"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --quiet gittok feed-watch)"
    ]
  }
}
