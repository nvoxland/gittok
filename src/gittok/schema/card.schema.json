{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gittok.local/card.schema.json",
  "title": "GitTok card submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "relpath": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "lines": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2, "maxItems": 2, "items": false
    },
    "persona": {"type": "string", "enum": ["greybeard", "penny_learns", "archivist", "meme_compiler", "paranoid_sec", "shipit_sam"]},
    "callout": {
      "type": "object", "additionalProperties": false, "required": ["line", "text"],
      "properties": {"line": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "code_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "repo", "path", "commit", "lines"],
      "properties": {
        "kind": {"const": "code"},
        "repo": {"type": "string"},
        "path": {"$ref": "#/$defs/relpath"},
        "commit": {"$ref": "#/$defs/sha"},
        "lines": {"$ref": "#/$defs/lines"},
        "excerpt": {"type": "string", "maxLength": 4000},
        "callouts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/callout"}}
      }
    },
    "text_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "text"},
        "title": {"type": "string", "maxLength": 120},
        "body": {"type": "string", "minLength": 1, "maxLength": 1200},
        "bullets": {"type": "array", "maxItems": 7, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "explain_panel": {
      "type": "object", "additionalProperties": false, "required": ["kind", "text"],
      "properties": {"kind": {"const": "explain"}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "code_panel": {
      "type": "object", "additionalProperties": false, "required": ["kind", "repo", "path", "commit", "lines"],
      "properties": {
        "kind": {"const": "code"}, "repo": {"type": "string"}, "path": {"$ref": "#/$defs/relpath"},
        "commit": {"$ref": "#/$defs/sha"}, "lines": {"$ref": "#/$defs/lines"}
      }
    },
    "diff_panel": {
      "type": "object", "additionalProperties": false, "required": ["kind", "repo", "commit", "path"],
      "properties": {
        "kind": {"const": "code_diff"}, "repo": {"type": "string"}, "commit": {"$ref": "#/$defs/sha"},
        "path": {"$ref": "#/$defs/relpath"}
      }
    },
    "source": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["repo", "commit"],
         "properties": {"repo": {"type": "string"}, "commit": {"$ref": "#/$defs/sha"}}},
        {"type": "object", "additionalProperties": false, "required": ["repo", "path"],
         "properties": {"repo": {"type": "string"}, "path": {"$ref": "#/$defs/relpath"}, "lines": {"$ref": "#/$defs/lines"}}}
      ]
    },
    "series": {
      "type": "object", "additionalProperties": false, "required": ["key", "part", "of"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 60},
        "part": {"type": "integer", "minimum": 1, "maximum": 5},
        "of": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "str200": {"type": "string", "minLength": 1, "maxLength": 200},
    "account": {"type": "string", "minLength": 1, "maxLength": 450},
    "strs5": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/str200"}},
    "strs1_5": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/str200"}},
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["prompt", "caption"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 400},
        "caption": {"type": "string", "minLength": 1, "maxLength": 140}
      }
    },
    "mascot_names": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "meme_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "template", "lines"],
      "properties": {
        "kind": {"const": "meme"}, "template": {"type": "string", "minLength": 1, "maxLength": 60},
        "lines": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    },
    "text_meme_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "style", "lines"],
      "properties": {
        "kind": {"const": "text_meme"},
        "style": {"enum": ["pov", "nobody_me", "starter_pack", "expectation_reality"]},
        "lines": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 140}}
      }
    },
    "illustration_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "prompt", "caption"],
      "properties": {
        "kind": {"const": "illustration"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 400},
        "caption": {"type": "string", "minLength": 1, "maxLength": 140},
        "mascots": {"$ref": "#/$defs/mascot_names"}
      }
    },
    "comic_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "panels"],
      "properties": {
        "kind": {"const": "comic"},
        "panels": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/scene"}},
        "mascots": {"$ref": "#/$defs/mascot_names"}
      }
    },
    "chart_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "chart", "repo"],
      "properties": {
        "kind": {"const": "chart"},
        "chart": {"enum": ["top_churn_files", "top_churn_dirs", "commit_hours", "author_shares", "co_change"]},
        "repo": {"type": "string"},
        "window": {"enum": ["30", "90", "365"]},
        "dir": {"type": "string", "minLength": 1, "maxLength": 400},
        "title": {"type": "string", "maxLength": 80}
      },
      "if": {"properties": {"chart": {"const": "author_shares"}}},
      "then": {"required": ["dir"]}
    },
    "diagram_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "mermaid"],
      "properties": {
        "kind": {"const": "diagram"},
        "title": {"type": "string", "maxLength": 120},
        "mermaid": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "template_visual": {
      "type": "object", "additionalProperties": false, "required": ["kind", "template", "data"],
      "properties": {
        "kind": {"const": "template"},
        "template": {"enum": ["iceberg", "tier_list", "group_chat", "flags", "dating_profile", "glow_up", "breaking_news", "horoscope", "thread", "day_in_life", "hot_take"]},
        "data": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"template": {"const": "iceberg"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_iceberg"}}}},
        {"if": {"properties": {"template": {"const": "tier_list"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_tier_list"}}}},
        {"if": {"properties": {"template": {"const": "group_chat"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_group_chat"}}}},
        {"if": {"properties": {"template": {"const": "flags"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_flags"}}}},
        {"if": {"properties": {"template": {"const": "dating_profile"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_dating_profile"}}}},
        {"if": {"properties": {"template": {"const": "glow_up"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_glow_up"}}}},
        {"if": {"properties": {"template": {"const": "breaking_news"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_breaking_news"}}}},
        {"if": {"properties": {"template": {"const": "horoscope"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_horoscope"}}}},
        {"if": {"properties": {"template": {"const": "thread"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_thread"}}}},
        {"if": {"properties": {"template": {"const": "day_in_life"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_day_in_life"}}}},
        {"if": {"properties": {"template": {"const": "hot_take"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/t_hot_take"}}}}
      ]
    },
    "t_iceberg": {
      "type": "object", "additionalProperties": false, "required": ["title", "layers"],
      "properties": {
        "title": {"$ref": "#/$defs/str200"},
        "layers": {"type": "array", "minItems": 3, "maxItems": 6, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "items"],
          "properties": {"label": {"$ref": "#/$defs/str200"}, "items": {"$ref": "#/$defs/strs1_5"}}}}
      }
    },
    "t_tier_list": {
      "type": "object", "additionalProperties": false, "required": ["title", "rows"],
      "properties": {
        "title": {"$ref": "#/$defs/str200"},
        "rows": {"type": "array", "minItems": 2, "maxItems": 6, "items": {
          "type": "object", "additionalProperties": false, "required": ["tier", "items"],
          "properties": {
            "tier": {"enum": ["S", "A", "B", "C", "D", "F"]},
            "items": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "why"],
              "properties": {"name": {"$ref": "#/$defs/str200"}, "why": {"$ref": "#/$defs/str200"}}}}
          }}}
      }
    },
    "t_group_chat": {
      "type": "object", "additionalProperties": false, "required": ["title", "messages"],
      "properties": {
        "title": {"$ref": "#/$defs/str200"},
        "messages": {"type": "array", "minItems": 2, "maxItems": 10, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "text"],
          "properties": {"from": {"$ref": "#/$defs/account"}, "text": {"$ref": "#/$defs/str200"}}}}
      }
    },
    "t_flags": {
      "type": "object", "additionalProperties": false, "required": ["subject", "red", "green"],
      "properties": {"subject": {"$ref": "#/$defs/str200"}, "red": {"$ref": "#/$defs/strs5"}, "green": {"$ref": "#/$defs/strs5"}},
      "anyOf": [{"properties": {"red": {"minItems": 1}}}, {"properties": {"green": {"minItems": 1}}}]
    },
    "t_dating_profile": {
      "type": "object", "additionalProperties": false, "required": ["name", "age", "bio", "likes", "dealbreakers"],
      "properties": {
        "name": {"$ref": "#/$defs/account"}, "age": {"$ref": "#/$defs/str200"}, "bio": {"$ref": "#/$defs/str200"},
        "likes": {"$ref": "#/$defs/strs1_5"}, "dealbreakers": {"$ref": "#/$defs/strs1_5"}
      }
    },
    "t_glow_up": {
      "type": "object", "additionalProperties": false, "required": ["subject", "before", "after"],
      "properties": {
        "subject": {"$ref": "#/$defs/str200"},
        "before": {"$ref": "#/$defs/glow_side"}, "after": {"$ref": "#/$defs/glow_side"}
      }
    },
    "glow_side": {
      "type": "object", "additionalProperties": false, "required": ["label", "text"],
      "properties": {"label": {"$ref": "#/$defs/str200"}, "text": {"$ref": "#/$defs/str200"}}
    },
    "t_breaking_news": {
      "type": "object", "additionalProperties": false, "required": ["headline"],
      "properties": {"headline": {"$ref": "#/$defs/str200"}, "subhead": {"$ref": "#/$defs/str200"}, "ticker": {"$ref": "#/$defs/strs5"}}
    },
    "t_horoscope": {
      "type": "object", "additionalProperties": false, "required": ["subject", "sign", "forecast"],
      "properties": {
        "subject": {"$ref": "#/$defs/account"}, "sign": {"$ref": "#/$defs/str200"},
        "forecast": {"type": "string", "minLength": 1, "maxLength": 400}, "lucky": {"$ref": "#/$defs/str200"}
      }
    },
    "t_thread": {
      "type": "object", "additionalProperties": false, "required": ["posts"],
      "properties": {"posts": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 280}}}
    },
    "t_day_in_life": {
      "type": "object", "additionalProperties": false, "required": ["subject", "steps"],
      "properties": {
        "subject": {"$ref": "#/$defs/account"},
        "steps": {"type": "array", "minItems": 3, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["time", "text"],
          "properties": {"time": {"$ref": "#/$defs/str200"}, "text": {"$ref": "#/$defs/str200"}}}}
      }
    },
    "t_hot_take": {
      "type": "object", "additionalProperties": false, "required": ["take"],
      "properties": {"take": {"type": "string", "minLength": 1, "maxLength": 280}}
    },
    "interaction": {
      "type": "object", "additionalProperties": false, "required": ["question", "choices", "explanation"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 200},
        "choices": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "answer_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "answer_fact": {
          "type": "object", "additionalProperties": false, "required": ["seed", "subject", "fact_ids"],
          "properties": {
            "seed": {"enum": ["first_call", "caller_count", "introduced_in", "defined_in", "calls_which"]},
            "subject": {"type": "string", "minLength": 1, "maxLength": 300},
            "fact_ids": {"type": "array", "maxItems": 12, "items": {"type": "string", "pattern": "^[a-z]{2,5}-[0-9a-f]{12}$"}}
          }
        },
        "explanation": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "fact": {"oneOf": [
      {"type": "string", "pattern": "^[a-z]{2,5}-[0-9a-f]{12}$"},
      {"type": "object", "additionalProperties": false, "required": ["calls"], "properties": {"calls": {"$ref": "#/$defs/str_pair"}}},
      {"type": "object", "additionalProperties": false, "required": ["defines"], "properties": {"defines": {"$ref": "#/$defs/str_pair"}}},
      {"type": "object", "additionalProperties": false, "required": ["touched"], "properties": {"touched": {"$ref": "#/$defs/str_pair"}}},
      {"type": "object", "additionalProperties": false, "required": ["imports"], "properties": {"imports": {"$ref": "#/$defs/str_pair"}}},
      {"type": "object", "additionalProperties": false, "required": ["returns"], "properties": {"returns": {"$ref": "#/$defs/str_pair"}}},
      {"type": "object", "additionalProperties": false, "required": ["accepts"], "properties": {"accepts": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "prefixItems": [{"type": "string", "minLength": 1, "maxLength": 300},
                        {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 100}}]}}},
      {"type": "object", "additionalProperties": false, "required": ["may_be_nil"], "properties": {"may_be_nil": {
        "type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}}}},
      {"type": "object", "additionalProperties": false, "required": ["params"], "properties": {"params": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "prefixItems": [{"type": "string", "minLength": 1, "maxLength": 300}, {"type": "integer", "minimum": 0, "maximum": 99}]}}}
    ]},
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["text", "kind", "source"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 240},
        "kind": {"const": "interpretive"},
        "source": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["commit"], "properties": {"commit": {"$ref": "#/$defs/sha"}}},
          {"type": "object", "additionalProperties": false, "required": ["pr"], "properties": {"pr": {"type": "string", "maxLength": 300}}},
          {"type": "object", "additionalProperties": false, "required": ["comment"], "properties": {"comment": {"$ref": "#/$defs/claim_line"}}},
          {"type": "object", "additionalProperties": false, "required": ["doc"], "properties": {"doc": {"$ref": "#/$defs/claim_line"}}}
        ]}
      }
    },
    "claim_line": {
      "type": "object", "additionalProperties": false, "required": ["path", "line"],
      "properties": {"path": {"$ref": "#/$defs/relpath"}, "line": {"type": "integer", "minimum": 1}}
    },
    "str_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story_type", "format", "persona", "tone", "angle", "repos", "dirs", "hook", "learn", "visual", "depth", "sources"],
      "properties": {
        "story_type": {"enum": [
          "commit_drama", "hot_spot", "archaeology", "rip", "ancient_todo", "secret_couples", "whose_code",
          "what_it_does", "journey", "analogy", "snippet_callouts", "cursed_clever_line", "before_after", "new_arrival",
          "spot_the_bug", "guess_who", "guess_when", "quiz", "this_or_that",
          "weekly_recap", "drift_alert", "ripple"
        ]},
        "format": {"enum": [
          "code_card", "text_post", "fun_fact", "listicle", "eli5", "meme", "text_meme", "mascot_scene", "comic",
          "chart", "diagram", "iceberg", "tier_list", "group_chat", "flags", "dating_profile", "glow_up",
          "breaking_news", "horoscope", "thread", "day_in_life", "hot_take", "quiz"
        ]},
        "account": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+:.+$", "maxLength": 450},
        "persona": {"$ref": "#/$defs/persona"},
        "tone": {"enum": ["wholesome-nerdy", "dry-deadpan", "roast", "hype", "chaotic-absurd", "earnest-teacher"]},
        "repos": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "dirs": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 400}},
        "angle": {"enum": ["what", "how", "why", "who", "risk"]},
        "verdict": {"enum": ["good", "bad", "clever", "cursed", "core"]},
        "hook": {"type": "string", "minLength": 1, "maxLength": 200},
        "facts": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/fact"}},
        "claims": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/claim"}},
        "learn": {"type": "string", "minLength": 20, "maxLength": 140},
        "visual": {"oneOf": [
          {"$ref": "#/$defs/code_visual"}, {"$ref": "#/$defs/text_visual"}, {"$ref": "#/$defs/meme_visual"},
          {"$ref": "#/$defs/text_meme_visual"}, {"$ref": "#/$defs/illustration_visual"}, {"$ref": "#/$defs/comic_visual"},
          {"$ref": "#/$defs/chart_visual"}, {"$ref": "#/$defs/diagram_visual"}, {"$ref": "#/$defs/template_visual"}
        ]},
        "depth": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {"oneOf": [{"$ref": "#/$defs/explain_panel"}, {"$ref": "#/$defs/code_panel"}, {"$ref": "#/$defs/diff_panel"}]}
        },
        "comments": {
          "type": "array", "maxItems": 5,
          "items": {"type": "object", "additionalProperties": false, "required": ["persona", "text"],
                    "properties": {"persona": {"$ref": "#/$defs/persona"}, "text": {"type": "string", "minLength": 1, "maxLength": 280}, "spoiler": {"type": "boolean"}}}
        },
        "interaction": {"$ref": "#/$defs/interaction"},
        "series": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/series"}]},
        "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
