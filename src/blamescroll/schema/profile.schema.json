{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blamescroll.local/profile.schema.json",
  "title": "Blamescroll repo profile (local/profiles/<repo>.yaml)",
  "description": "Rules are data. Blamescroll never runs code from a profile.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "written_at": {"type": "string", "minLength": 1, "maxLength": 40},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "stack": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 60}, "maxItems": 20},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 20},
    "roles": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 200},
      "maxProperties": 100
    },
    "ignore": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "maxItems": 100},
    "scan": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "maxItems": 100},
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {"$ref": "#/$defs/globs"},
        "fixture": {"$ref": "#/$defs/globs"},
        "generated": {"$ref": "#/$defs/globs"},
        "docs": {"$ref": "#/$defs/globs"},
        "vendored": {"$ref": "#/$defs/globs"}
      }
    },
    "generated_markers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200},
      "maxItems": 10
    },
    "queries": {
      "type": "object",
      "description": "Tree-sitter tags query text per grammar name (config/queries/*.scm format)",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,30}$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 6000},
      "maxProperties": 8
    },
    "detectors": {"type": "array", "items": {"$ref": "#/$defs/detector"}, "maxItems": 60},
    "sinks": {
      "type": "array",
      "description": "Calls that have an effect (regex on a callee name or symbol, or on a line of a definition body)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {"type": "string", "minLength": 1, "maxLength": 40}
        }
      },
      "maxItems": 60
    },
    "conventions": {
      "type": "array",
      "description": "Naming conventions of this codebase: a definition name regex and what it promises",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name_regex", "means"],
        "properties": {
          "name_regex": {"type": "string", "minLength": 1, "maxLength": 200},
          "means": {"enum": ["effectful", "pure"]}
        }
      },
      "maxItems": 20
    },
    "nil_guards": {
      "type": "array",
      "description": "Regexes that count as a nil check around the result of a call",
      "items": {"type": "string", "minLength": 1, "maxLength": 200},
      "maxItems": 30
    },
    "nil_markers": {
      "type": "array",
      "description": "Words in a returns type that mean the value may be nil (matched as plain text)",
      "items": {"type": "string", "minLength": 1, "maxLength": 60},
      "maxItems": 20
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "glob": {"type": "string", "minLength": 1, "maxLength": 200},
    "globs": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "maxItems": 100},
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "match", "weight"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "tag": {"$ref": "#/$defs/slug"},
        "verdict_hint": {"enum": ["good", "bad", "clever", "cursed", "core"]},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths"],
          "properties": {
            "regex": {"type": "string", "minLength": 1, "maxLength": 500},
            "ast_grep": {"type": "string", "minLength": 1, "maxLength": 500},
            "language": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
            "paths": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "minItems": 1, "maxItems": 30},
            "exclude": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "maxItems": 30}
          },
          "oneOf": [{"required": ["regex"]}, {"required": ["ast_grep"]}]
        },
        "window": {"type": "integer", "minimum": 1, "maximum": 40, "default": 20},
        "weight": {"type": "number", "minimum": 0.1, "maximum": 3},
        "why": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    }
  }
}
